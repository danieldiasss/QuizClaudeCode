# Public base URL (used for share links and Open Graph images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data store: "memory" (dev/tests, no setup) or "supabase" (production)
DATA_STORE=memory

# Supabase — server-only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to hash IPs for rate limiting
IP_HASH_SALT=change-me
